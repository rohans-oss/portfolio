# Copy this file to .env and fill in ONE key to enable the full AI chat.
# Without a key the chat still works using the built-in offline answers.
# Never commit your real .env file (it's already in .gitignore).

# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free: https://console.groq.com
GROQ_API_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=
