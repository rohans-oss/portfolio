{
  "name": "rohan-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:pages": "vite build --base /portfolio/ && node -e \"require('fs').writeFileSync('dist/.nojekyll','')\" && gh-pages -d dist -t",
    "test:chat": "node scripts/test-chat.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test": "npm run check:content && npm run test:chat"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "d3-force": "^3.0.0",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
